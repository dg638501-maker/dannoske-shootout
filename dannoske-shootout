   </section>
   <section class="stage" id="stage">
    <div class="box"></div>
    <div class="spot"></div>
    <div class="goal" id="goal">
     <div class="keeper" id="keeper" aria-hidden="true">
      <svg viewBox="0 0 60 92" role="img" aria-label="Goalkeeper">
       <circle cx="30" cy="12" r="10" fill="#e8b48a" /> <path d="M18 6a12 11 0 0 1 24 0v3H18z" fill="#2b1d12" /> <rect x="16" y="24" width="28" height="34" rx="8" fill="#ffc233" /> <rect x="18" y="56" width="10" height="30" rx="4" fill="#12301c" /> <rect x="32" y="56" width="10" height="30" rx="4" fill="#12301c" /> <rect x="4" y="22" width="12" height="9" rx="4" transform="rotate(-50 10 26)" fill="#ffc233" /> <rect x="44" y="22" width="12" height="9" rx="4" transform="rotate(50 50 26)" fill="#ffc233" /> <circle cx="4" cy="12" r="6" fill="#35d65b" /><circle cx="56" cy="12" r="6" fill="#35d65b" />
      </svg>
     </div>
     <div class="zones" id="zones"></div>
    </div>
    <div class="ball" id="ball"></div>
    <div class="toast" id="toast" role="status"></div>
    <button class="mbtn" id="mbtn" type="button">Levels</button>
    <div class="end" id="end" hidden></div>
   </section>
   <section class="ctl">
    <div class="msg" id="msg">Get ready</div>
    <div class="meter" id="meter" aria-hidden="true">
     <span class="mk" id="mk"></span>
    </div>
    <div class="timer" id="timer" hidden aria-hidden="true">
     <i id="tf"></i>
    </div>
    <div class="hint" id="hint"></div>
   </section>
  </div>
  <div class="menu" id="menu" hidden></div>
