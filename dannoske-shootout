     <span class="nm">You</span>
     <div class="dots" id="dY"></div>
    </div>
    <div class="mid">
     <span class="lv" id="lvl">Level 1</span>
     <div class="sc" aria-live="polite">
      <span id="nY">0</span><i>-</i><span id="nC">0</span>
