<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <style>[hidden]{display:none!important}body{margin:0}</style>
  <title>Dannoske Shootout</title>
  <meta name="claude:viewport-fit-sides" content="cover">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&amp;family=Barlow:wght@500;600;700&amp;display=swap">
  <style>
/* Layout concept: one portrait screen. Scoreboard on top, pitch with the goal in the middle,
   a timing meter / dive timer at the bottom. Single committed look: night pitch, white lines, one amber kit. */
:root{
  --bg:#07120c;
  --pitch-a:#0e3a1f;
  --pitch-b:#0b3119;
  --line:#e9f3ec;
  --ink:#f3f8f4;
  --muted:#9db3a3;
  --accent:#35d65b;
  --accent-ink:#03140a;
  --brand:#ff3a2f;
  --kit:#ffc233;
  --bad:#ff6a5e;
  --panel:rgba(5,14,9,.82);
  --f-display:'Big Shoulders Display','Arial Narrow',Impact,sans-serif;
  --f-body:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif;
  --ball:clamp(30px,11vw,46px);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
html,body{min-height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.35;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:10px;overflow-x:hidden;-webkit-tap-highlight-color:transparent;touch-action:manipulation;user-select:none;-webkit-user-select:none}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
#app{height:100vh;height:100dvh;min-height:640px;max-width:520px;margin:0 auto;display:flex;flex-direction:column;gap:10px;min-height:0}

/* scoreboard */
.board{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;flex:none}
.side{display:flex;flex-direction:column;gap:6px;min-width:0}
.side.r{align-items:flex-end}
.nm{font-family:var(--f-display);font-weight:800;letter-spacing:.08em;font-size:14px;color:var(--muted);text-transform:uppercase;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.side.on .nm{color:var(--accent)}
.dots{display:flex;gap:5px;flex-wrap:wrap}
.side.r .dots{justify-content:flex-end}
.dot{width:14px;height:14px;border-radius:50%;border:2px solid #36513f;background:transparent}
.dot.g{background:var(--accent);border-color:var(--accent)}
.dot.m{background:var(--bad);border-color:var(--bad)}
.dot.now{border-color:var(--ink)}
.sc{font-family:var(--f-display);font-weight:900;font-size:54px;line-height:1;display:flex;gap:10px;align-items:center;font-variant-numeric:tabular-nums}
.sc i{font-style:normal;color:var(--muted);font-size:34px}

/* stage */
.stage{position:relative;flex:1;min-height:0;border-radius:18px;overflow:hidden;border:1px solid #1d4a2c;
  background:
   linear-gradient(180deg,rgba(7,18,12,.95) 0,rgba(7,18,12,0) 22%),
   repeating-linear-gradient(180deg,var(--pitch-a) 0 44px,var(--pitch-b) 44px 88px)}
.box{position:absolute;left:8%;right:8%;top:30%;bottom:-14%;border:2px solid rgba(233,243,236,.35);border-radius:6px}
.spot{position:absolute;left:50%;bottom:11%;width:8px;height:8px;margin-left:-4px;border-radius:50%;background:var(--line);opacity:.8}
.goal{position:absolute;left:50%;top:13%;width:min(88%,430px);aspect-ratio:2/1;transform:translateX(-50%);
  border:5px solid var(--line);border-bottom:0;border-radius:5px 5px 0 0;
  background:
   repeating-linear-gradient(45deg,rgba(233,243,236,.12) 0 1px,transparent 1px 10px),
   repeating-linear-gradient(-45deg,rgba(233,243,236,.12) 0 1px,transparent 1px 10px),
   rgba(4,12,8,.55)}
.zones{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr)}
.z{background:none;border:1px dashed rgba(233,243,236,.22);padding:0;position:relative;border-radius:0}
.z:disabled{cursor:default}
.z:not(:disabled):active,.z.pick{background:rgba(53,214,91,.28);border-color:var(--accent)}
.z::after{content:"";position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px;border-radius:50%;border:2px solid rgba(233,243,236,.35)}
.z:disabled::after{display:none}
.keeper{position:absolute;left:50%;bottom:0;width:17%;margin-left:-8.5%;transition:transform .38s cubic-bezier(.2,.8,.3,1);transform-origin:50% 80%;pointer-events:none}
.keeper svg{display:block;width:100%;height:auto}
.ball{position:absolute;left:0;top:0;width:var(--ball);height:var(--ball);border-radius:50%;pointer-events:none;will-change:transform;
  background:
   radial-gradient(circle at 50% 50%,#1b1b1b 0 14%,transparent 15%),
   radial-gradient(circle at 20% 28%,#1b1b1b 0 9%,transparent 10%),
   radial-gradient(circle at 80% 28%,#1b1b1b 0 9%,transparent 10%),
   radial-gradient(circle at 28% 82%,#1b1b1b 0 9%,transparent 10%),
   radial-gradient(circle at 72% 82%,#1b1b1b 0 9%,transparent 10%),
   radial-gradient(circle at 35% 30%,#fff,#d4dad6 72%);
  box-shadow:0 5px 8px rgba(0,0,0,.45)}
.toast{position:absolute;left:0;right:0;top:46%;text-align:center;font-family:var(--f-display);font-weight:900;font-size:clamp(44px,15vw,72px);letter-spacing:.02em;line-height:1;text-transform:uppercase;pointer-events:none;
  opacity:0;transform:scale(.8);text-shadow:0 4px 18px rgba(0,0,0,.7)}
.toast.show{opacity:1;transform:none;transition:opacity .12s,transform .18s}
.toast.g{color:var(--accent)}.toast.m{color:var(--bad)}

/* bottom control */
.ctl{flex:none;background:var(--panel);border:1px solid #1d4a2c;border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:10px}
.msg{font-weight:700;font-size:16px;text-align:center;min-height:22px}
.meter{--w:22%;--lo:42%;--hi:88%;position:relative;height:18px;border-radius:9px;overflow:hidden;
  background:linear-gradient(90deg,var(--bad) 0 var(--w),var(--kit) var(--w) var(--lo),var(--accent) var(--lo) var(--hi),var(--bad) var(--hi) 100%)}
.meter .mk{position:absolute;top:-3px;bottom:-3px;width:6px;margin-left:-3px;background:#fff;border-radius:3px;box-shadow:0 0 0 2px rgba(0,0,0,.55)}
.timer{height:10px;border-radius:5px;background:#16301f;overflow:hidden}
.timer i{display:block;height:100%;width:100%;background:var(--kit);transform-origin:0 50%}
.hint{color:var(--muted);font-size:13px;text-align:center}

/* end card */
.end{position:absolute;inset:0;background:rgba(3,9,6,.88);display:flex;align-items:center;justify-content:center;padding:20px;z-index:5}
.end[hidden]{display:none}
.card{width:100%;max-width:340px;display:flex;flex-direction:column;gap:12px;text-align:center}
.card h2{margin:0;font-family:var(--f-display);font-weight:900;font-size:56px;line-height:1;text-transform:uppercase}
.card h2.w{color:var(--accent)}.card h2.l{color:var(--bad)}
.card .fs{font-family:var(--f-display);font-weight:800;font-size:34px;font-variant-numeric:tabular-nums}
.card p{margin:0;color:var(--muted)}
.btn{height:50px;border-radius:12px;border:0;background:var(--brand);color:#fff;font-weight:700;font-size:17px}
.btn:active{transform:translateY(1px)}
.rec{display:flex;justify-content:center;gap:18px;color:var(--muted);font-size:13px}
.rec b{color:var(--ink);font-variant-numeric:tabular-nums}

.mid{display:flex;flex-direction:column;align-items:center;gap:2px}
.lv{font-family:var(--f-display);font-weight:800;letter-spacing:.14em;font-size:13px;color:var(--brand);text-transform:uppercase}
.mbtn{position:absolute;right:10px;top:8px;z-index:3;height:32px;padding:0 12px;border-radius:9px;border:1px solid #2d5a3b;background:var(--panel);font-weight:700;font-size:13px}
.btn.ghost{background:transparent;border:1px solid #2d5a3b;color:var(--ink)}
.menu{position:fixed;inset:0;z-index:20;background:var(--bg);overflow-y:auto;-webkit-overflow-scrolling:touch;
  padding-block:calc(18px + env(safe-area-inset-top,0px)) calc(24px + env(safe-area-inset-bottom,0px));
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.menu[hidden]{display:none}
.mwrap{max-width:520px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
.hero{display:block;width:min(100%,360px);height:auto;aspect-ratio:1/1;margin:0 auto;border-radius:22px;box-shadow:0 10px 40px rgba(255,58,47,.25)}
.elogo{display:block;width:84px;height:84px;margin:0 auto;border-radius:16px}
.credit{margin:0;text-align:center;color:var(--muted);font-size:13px;letter-spacing:.08em;text-transform:uppercase}
.sub{margin:0;color:var(--muted)}
.lvgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.lt{aspect-ratio:1/1;border-radius:14px;border:1px solid #2d5a3b;background:#0c2415;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:0}
.lt b{font-family:var(--f-display);font-weight:900;font-size:34px;line-height:1;font-variant-numeric:tabular-nums}
.lt span{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:700}
.lt.done{border-color:var(--accent)}.lt.done span{color:var(--accent)}
.lt.next{background:var(--brand);border-color:var(--brand);color:#fff}.lt.next span{color:#fff}
.lt.final b{color:var(--kit)}.lt.next.final b{color:#fff}
.lt:disabled{opacity:.4;cursor:not-allowed}
.nxt{background:var(--panel);border:1px solid #1d4a2c;border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:2px}
.nxt b{font-size:17px}.nxt span{color:var(--muted);font-size:13px}
@media (prefers-reduced-motion:reduce){.keeper{transition-duration:.01s}.toast.show{transition:none}}
</style>
 </head>
